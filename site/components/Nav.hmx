<style scoped>
/* The gutter comes from `body`; the nav only owns its own vertical rhythm. */
:global(.site-nav) {
  padding: 1.25rem 0;
}

/* The links are one Markdown paragraph, so the paragraph is the flex row. */
:global(.site-nav p) {
  display: flex;
  align-items: center;
  gap: 1.5rem;
  margin: 0;
  font-size: 0.95rem;
}

@media (max-width: 30rem) {
  :global(.site-nav p) {
    gap: 0.9rem;
    font-size: 0.85rem;
  }
}

:global(.site-nav p > a:first-child) {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  margin-right: auto;
  font-weight: 600;
  letter-spacing: -0.01em;
  color: inherit;
  text-decoration: none;
}

:global(.site-nav img) {
  display: block;
  width: 1.75rem;
  height: 1.75rem;
  border-radius: 0.35rem;
}

:global(.site-nav a) {
  color: var(--site-muted);
  text-decoration: none;
  /* "VS Code" broke across two lines at 375px, which reads as a layout bug. */
  white-space: nowrap;
}

:global(.site-nav a:hover) {
  color: var(--site-blue);
}
</style>

